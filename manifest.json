{
  "manifest_version": 3,
  "name": "ChatGPT Bulk Delete",
  "default_locale": "en",
  "version": "7.12",
  "description": "__MSG_extDescription__",
  "icons": {
    "48": "icon48.png"
  },
  "action": {
    "default_icon": "icon48.png",
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "permissions": ["scripting", "activeTab", "storage", "identity", "identity.email"],
  "host_permissions": ["https://bulk-delete-chatgpt-worker.qcrao.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://chat.openai.com/*", "*://chatgpt.com/*"],
      "js": [
        "i18n.js",
        "extensionCore.js",
        "config.js",
        "remoteConfig.js",
        "globals.js",
        "utils.js",
        "chatgptApi.js",
        "domHandler.js",
        "conversationHandler.js",
        "checkboxManager.js",
        "conversationPreview.js",
        "selectionBar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
